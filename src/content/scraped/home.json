 "testimonials": [
  {
   "quote": "We recognize and appreciate the efforts of mtandt's exemplary contribution to consistent HSE implementation.",
   "author": "SHAPOORJI PALLONJI",
   "logo": "/legacy/imageFile/1643953297.jpg"
  },
  {
   "quote": "The mtandt team has installed the Safety Lifeline System in a timely and safe manner which has resulted in providing a safe working environment for all workers in our factory.",
